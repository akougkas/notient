# Notient deployment environment.
#
# Except for the `NOTIENT_VAULT` selector described below, these variables
# are the sole authority for endpoint URLs, endpoint bearer credentials,
# model ids, model context, and reasoning capacity. They are never persisted
# to config.json or returned by daemon RPC. Set them in
# `<vault>/.notient/.env`, the canonical operator location read at daemon
# boot, or in the process environment as a fallback. The vault file wins:
# Bun auto-loads a `.env` from the working directory into every `notient`
# invocation, so an ambient project file cannot repoint a vault.
#
# Leave a line commented or absent to fall through to process env. An explicit
# empty value masks that process key. Context and slot capacity then use their
# documented defaults. The chat base URL has no built-in fallback; model ids
# may be discovered only when the endpoint exposes exactly one compatible
# model.
#
# Sample values below assume llama.cpp serving the chat model on port 8080
# and Ollama serving the embedding model on port 11434. Any OpenAI-compatible
# server works, LM Studio included; point the base URLs at whatever you run.

# Optional process-level default vault path for CLI and MCP commands when
# `--vault` is absent. Set this in the shell or a project-root `.env`, not in
# `<vault>/.notient/.env`: the CLI must select the vault before it can read
# that file. Resolution then falls back to a `.notient`/`.obsidian` ancestor
# and finally the last vault recorded by `notient init <vault>`.
# NOTIENT_VAULT=/absolute/path/to/MyVault

# OpenAI-compatible chat endpoint. Sets the base URL for the primary and deep
# endpoints, and for the embedding endpoint unless NOTIENT_EMBED_BASE_URL is
# also set.
NOTIENT_LLM_BASE_URL=http://127.0.0.1:8080/v1

# OpenAI-compatible embedding endpoint. Set this only when embeddings are
# served separately from chat. It overrides NOTIENT_LLM_BASE_URL for the
# embedding endpoint alone.
NOTIENT_EMBED_BASE_URL=http://127.0.0.1:11434/v1

# Optional RFC 6750 bearer token for the chat endpoint. Local servers normally
# leave this unset. Deliberately configured compatible cloud endpoints usually
# require it. Keep a vault file containing credentials mode 0600.
# NOTIENT_LLM_API_KEY=replace-with-endpoint-token

# Optional embedding bearer token. When absent it inherits
# NOTIENT_LLM_API_KEY. Set it to a different token for a separately protected
# embedding endpoint, or set it explicitly empty when chat is authenticated
# but a local embedding server is not.
# NOTIENT_EMBED_API_KEY=

# Chat model id. One value selects primary/deep reasoning and reranking. It
# must support tool calling for conversation use.
NOTIENT_LLM_MODEL=qwen3-30b-a3b-instruct

# Embedding model id, served by NOTIENT_EMBED_BASE_URL. Changing this model
# is safe: the daemon probes the vector width at boot, clears the stored
# vectors when the model or dimension changed, and resets Tier 2 only. Tier 3
# concepts, claims, questions, evidence, and timestamps remain intact. A
# durable repair re-embeds pending notes, then refreshes Linker's
# vector-derived proposals.
NOTIENT_EMBED_MODEL=nomic-embed-text

# Per-request chat context budget in tokens. The context manager summarizes
# history once a turn crosses `contextBudgetFraction` of this number. Keep
# NOTIENT_CONTEXT_TOKENS x NOTIENT_REASONING_SLOTS at or below the context
# length the server actually loaded the model with. Default: 32768.
NOTIENT_CONTEXT_TOKENS=32768

# Process-wide concurrency cap shared by chat, extraction, linking, and
# coordinator-dispatched reasoning calls. Match the capacity reserved on the
# model server.
# Default: 4.
NOTIENT_REASONING_SLOTS=4
