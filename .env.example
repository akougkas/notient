# Notient operator environment overrides.
#
# These variables override the persisted vault config in
# <vault>/.notient/config.json *in memory only* — they do not write back to
# disk. Set them either in this file (copy to .env at the project root for
# developer flows) or in <vault>/.notient/.env (the canonical operator
# location, read at daemon boot). Process env wins over either file so a
# one-shot `NOTIENT_LLM_MODEL=foo bun ... daemon start` works as expected.
#
# Leave any line commented or set to an empty value to fall through to the
# config.json persisted setting (or the hard-coded default if config.json
# is silent).

# OpenAI-compatible chat/embedding endpoint. Applies to primary, deep, and
# embedding base URLs in one shot.
# NOTIENT_LLM_BASE_URL=http://192.168.86.143:1234/v1

# Reasoning / fast / reranker / co-author model. One value sweeps all four
# slots.
# NOTIENT_LLM_MODEL=nvidia-nemotron-3-nano-omni-30b-a3b-reasoning

# Embedding model loaded on the same endpoint as the chat model.
# NOTIENT_EMBED_MODEL=text-embedding-nomic-embed-text-v2-moe

# Chat context budget in tokens. Should match the LM Studio
# loaded_context_length (or one slot of it under parallel partitioning).
# Notient warns at boot if loaded_context_length is smaller than this.
# NOTIENT_CONTEXT_TOKENS=200000
