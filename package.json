{
  "name": "notient",
  "version": "0.1.0",
  "description": "AI-powered vault management using local LLMs only",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:watch": "bun scripts/dev.ts --watch",
    "dev:reset": "bun scripts/dev.ts --reset",
    "dev:hard-reset": "bun scripts/dev.ts --hard-reset",
    "build": "bun run typecheck && bun scripts/build.ts",
    "build:dev": "bun scripts/build.ts --dev",
    "build:analyze": "bun scripts/build.ts --analyze",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "clean": "rm -f main.js main.js.map"
  },
  "keywords": [
    "obsidian",
    "ai",
    "local-llm",
    "semantic-search",
    "knowledge-management"
  ],
  "author": "Anthony Kougkas",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.0",
    "@types/node": "^20.10.0",
    "bun-types": "^1.0.18",
    "esbuild": "^0.19.8",
    "obsidian": "^1.4.11",
    "tslib": "^2.6.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@lmstudio/sdk": "^0.3.0",
    "@preact/signals": "^2.5.1",
    "ollama": "^0.5.0",
    "preact": "^10.28.2"
  }
}
