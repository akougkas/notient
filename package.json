{
  "name": "notient",
  "version": "0.1.0-phaseA",
  "description": "Local-first agentic CLI for sentient vaults",
  "type": "module",
  "bin": {
    "notient": "./dist/notient.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:smoke": "NOTIENT_SMOKE=1 bun test src/daemon/__smoke__",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "build:cli": "bun scripts/build-cli.ts",
    "smoke:cli:phaseA": "bun scripts/smoke-cli-phaseA.ts",
    "smoke:cli:phaseB": "bun scripts/smoke-cli-phaseB.ts",
    "smoke:cli:phaseC": "bun scripts/smoke-cli-phaseC.ts",
    "smoke:cli:phaseD": "bun scripts/smoke-cli-phaseD.ts",
    "smoke:cli:phaseD1": "bun scripts/smoke-cli-phaseD1.ts"
  },
  "keywords": [
    "ai",
    "local-llm",
    "semantic-search",
    "knowledge-management",
    "cli",
    "agentic"
  ],
  "author": "Anthony Kougkas",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.14",
    "@types/sql.js": "^1.4.9",
    "@types/unist": "^3.0.3",
    "bun-types": "^1.0.18",
    "tslib": "^2.6.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@lmstudio/sdk": "^1.5.0",
    "@opentui/core": "0.1.105",
    "@opentui/react": "0.1.105",
    "chokidar": "^4.0.0",
    "hnswlib-wasm": "^0.8.2",
    "kysely": "^0.28.9",
    "mdast-util-to-string": "^4.0.0",
    "ollama": "^0.6.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sql.js": "^1.13.0",
    "surrealdb": "^2.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unpdf": "^0.12.0"
  }
}
